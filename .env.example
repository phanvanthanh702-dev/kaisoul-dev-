# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/kaisoul_dev?schema=public"

# Authentication & Session Secrets
JWT_SECRET="your_jwt_secret_must_be_at_least_32_bytes_long"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# AI Integration
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# AWS S3 Storage
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
S3_BUCKET_NAME="your_s3_bucket_name"

# Deployment Configuration
DEPLOYMENT_STRATEGY="local" # Options: "local" | "s3"
DEPLOYMENT_BASE_DOMAIN="kdev.app"
